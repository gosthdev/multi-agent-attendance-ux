    "/api/v1/attendance/{id}/rekognition": {
      "put": {
        "description": "Uploads a student photo to AWS Rekognition for facial recognition. The face ID is stored on the student record for future attendance checks.",
        "operationId": "AttendanceController_updateRekognition",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Student UUID",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["photo"],
                "properties": {
                  "photo": {
                    "type": "string",
                    "format": "binary",
                    "description": "Student face photo. Max 150 KB. Allowed formats: JPEG, JPG, PNG."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "default": {
            "description": ""
          }
        },
        "summary": "Register student face for attendance",
        "tags": ["Attendance"]
      }
    },
    "/api/v1/attendance/schedule": {
      "post": {
        "description": "Searches the uploaded photo against registered faces in AWS Rekognition. Matches the recognized student to their current schedule and records attendance. Grace period: 0 minutes after schedule start time before marked as late.",
        "operationId": "AttendanceController_registerAttendance",
        "parameters": [
          {
            "name": "time",
            "required": false,
            "in": "query",
            "description": "Simulated datetime (ISO string) for testing. If omitted, current server time is used.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["photo"],
                "properties": {
                  "photo": {
                    "type": "string",
                    "format": "binary",
                    "description": "Photo to search for face match. Max 50 KB. Allowed formats: JPEG, JPG, PNG."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "default": {
            "description": ""
          }
        },
        "summary": "Register attendance via facial recognition",
        "tags": ["Attendance"]
      }
    },
